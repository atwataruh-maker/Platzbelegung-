Options -Indexes -MultiViews
DirectoryIndex index.php
<FilesMatch "^(config(?:\.example)?\.php|INSTALLATION\.md|README\.md|package.*\.json|composer.*|.*\.sql)$">
 Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(?:server|var|tools|tests|frontend|frontend-dist|app|lib|components|docs|build|db|drizzle|scripts|vendor|node_modules)(?:/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
