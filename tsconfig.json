{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "app/page.tsx",
    "app/platzbelegung/page.tsx",
    "app/kabinenbelegung/page.tsx",
    "app/ehrenamt/page.tsx",
    "components/cabin-plan.tsx",
    "components/upcoming-matches.tsx",
    "components/ui/button.tsx",
    "vite.strato.config.ts"
  ],
  "exclude": [
    "node_modules",
    "upload"
  ]
}
